        "style": "normal",
        "markDefs": [],
        "children": [
          {
            "_type": "span",
            "_key": "n1s1",
            "text": "A server component runs where the data lives. The browser never receives the query, only the markup it produced.",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "_key": "n2",
        "style": "h2",
        "markDefs": [],
        "children": [
          {
            "_type": "span",
            "_key": "n2s1",
            "text": "Where the boundary sits",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "_key": "n3",
        "style": "normal",
        "markDefs": [],
        "children": [
          {
            "_type": "span",
            "_key": "n3s1",
            "text": "Push the boundary down until the smallest useful piece is interactive. Everything above it stays on the server.",
            "marks": []
          }
        ]
      }
    ],
    "keyPoints": [
      "Split rendering by capability, not by file size",
      "Keep secrets behind the server boundary",
      "Stream the slow parts instead of blocking the whole page"
    ],
    "proTip": "If a component needs a token to render, it belongs on the server. There is no version of that which is safe in the browser.",
