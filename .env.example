# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity (public values, safe for the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-03

# Sanity read token. Server only — never prefix this with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=sk_xxx

# Sanity Context MCP. Server only — never prefix these with NEXT_PUBLIC_.
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v2026-11-10/context/organizations/your-organization-id/mcp/vertex-search
SANITY_ORGANIZATION_TOKEN=sk_xxx

# Google Gemini. Server only — never prefix this with NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=your-key
GOOGLE_MODEL=gemini-3.1-flash-lite
