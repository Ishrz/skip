# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity (public values, safe for the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-03

# Sanity read token. Server only — never prefix this with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=sk_xxx

# Sanity Context MCP. Server only — never prefix these with NEXT_PUBLIC_.
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v2026-11-10/context/organizations/your-organization-id/mcp/vertex-search
SANITY_ORGANIZATION_TOKEN=sk_xxx

# Google Gemini. Server only — never prefix this with NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=your-key
GOOGLE_MODEL=gemini-3.1-flash-lite
# Second Google model, tried when the primary model fails (for example a 503
# under high demand). Same key. Leave empty to disable the extra attempt.
GOOGLE_FALLBACK_MODEL=gemini-3.5-flash

# Mistral fallback. Server only — never prefix this with NEXT_PUBLIC_.
# Only used when the Google attempt fails (5xx, 429, timeout).
# Free-tier limits measured on a real key: Ministral 3B/8B/14B = 2 requests/min
# and 40k tokens/min; mistral-large-4 = 50 requests/min and 20k tokens/min;
# Small and Medium reject a free key. A full search needs several model calls,
# so a free key is best-effort only.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-14b-latest

# Video ingestion (offline scripts only). Server only — never prefix these with NEXT_PUBLIC_.
# Optional: private Vimeo videos.
VIMEO_ACCESS_TOKEN=
# Required for Bunny Stream ingestion. Never expose this to the browser.
BUNNY_STREAM_API_KEY=
# Optional: used when a Bunny embed URL does not include the library id.
BUNNY_STREAM_LIBRARY_ID=
# Optional: signed playback token and expiry for token-protected Bunny libraries.
BUNNY_STREAM_TOKEN=
BUNNY_STREAM_EXPIRES=
